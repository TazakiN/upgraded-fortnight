\usepackage{listings}

% ==========================================
% 1. Definisi Bahasa Move yang Lebih Lengkap
% ==========================================
\lstdefinelanguage{Move}{
	% Kata kunci utama (control flow, visibility, deklarasi)
	keywords={public, struct, has, store, key, drop, copy, fun, let, mut, return, abort, module, use, entry, acquires, as, break, const, continue, else, false, friend, if, loop, macro, native, phantom, spec, true, while, inline},
	keywordstyle=\bfseries,
	% Tipe data bawaan dan struktur umum
	ndkeywords={address, bool, u8, u16, u32, u64, u128, u256, vector, signer, String, Option},
	ndkeywordstyle=\bfseries,
	sensitive=true,
	comment=[l]{//},
	morecomment=[s]{/*}{*/},
	commentstyle=\itshape,
	stringstyle=\ttfamily,
	morestring=[b]"
}

% ==========================================
% 2. Definisi Bahasa Rust yang Lebih Lengkap
% ==========================================
\lstdefinelanguage{Rust}{
	% Kata kunci utama Rust
	keywords={as, break, const, continue, crate, else, enum, extern, false, fn, for, if, impl, in, let, loop, match, mod, move, mut, pub, ref, return, self, Self, static, struct, super, trait, true, type, unsafe, use, where, while, async, await, dyn, union},
	keywordstyle=\bfseries,
	% Tipe data primitif dan struktur standar library
	ndkeywords={i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64, bool, char, str, String, Vec, Option, Result, Box, Rc, Arc, Cell, RefCell, HashMap},
	ndkeywordstyle=\bfseries,
	sensitive=true,
	comment=[l]{//},
	morecomment=[s]{/*}{*/},
	% Komentar dokumentasi Rust (///)
	morecomment=[l]{///},
	commentstyle=\itshape,
	stringstyle=\ttfamily,
	morestring=[b]"
}

% ==========================================
% 3. Pengaturan Global (Tampilan Blok Kode)
% ==========================================
\lstset{
	basicstyle=\ttfamily\small,         % Font monospace dengan ukuran kecil
	columns=fullflexible,               % Spasi antar karakter lebih natural
	breakatwhitespace=false,
	breaklines=true,                    % Otomatis pindah baris jika teks terlalu panjang
	captionpos=b,                       % Posisi caption di bawah (b = bottom)
	keepspaces=true,                    % Menjaga spasi tetap terlihat
	% Pengaturan Frame dan Nomor Baris
	frame=single,                       % Garis tepi kotak
	rulecolor=\color{black},            % Garis tepi hitam
	numbers=left,                       % Posisi penomoran baris di kiri
	numbersep=10pt,                     % Jarak antara nomor baris dan kode
	numberstyle=\tiny,                  % Gaya angka penomoran baris
	showspaces=false,
	showstringspaces=false,             % Tidak menampilkan underscore pada spasi di dalam string
	showtabs=false,
	tabsize=4,                          % Ukuran tab diset ke 4 spasi
	xleftmargin=2em,                    % Margin kiri agar nomor baris tidak menabrak teks paragraf
	framexleftmargin=1.5em,             % Jarak dalam frame sebelah kiri
	framesep=5pt,                       % Padding dalam frame
	aboveskip=1em,
	belowskip=1em
}
